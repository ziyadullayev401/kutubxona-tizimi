{
  "name": "kutubxona-tizimi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kutubxona boshqaruv tizimi: React + Express + SQLite (relatsion SQL)",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"node --disable-warning=ExperimentalWarning --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node --disable-warning=ExperimentalWarning server/index.js",
    "server": "node --disable-warning=ExperimentalWarning server/index.js",
    "db:reset": "node server/reset.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bootstrap": "^5.3.9",
    "bootstrap-icons": "^1.13.2",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
